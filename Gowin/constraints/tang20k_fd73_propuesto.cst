// Tang Nano20K GW2AR-LV18QN88C8/I7. Numeros del encapsulado, no de cabecera.
IO_LOC "clk27" 4;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "key_s1" 88;
IO_PORT "key_s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN SINGLE_RESISTOR=ON BANK_VCCIO=3.3;
IO_LOC "key_s2" 87;
IO_PORT "key_s2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN SINGLE_RESISTOR=ON BANK_VCCIO=3.3;

IO_LOC "adc_db[0]" 27;
IO_LOC "adc_db[1]" 28;
IO_LOC "adc_db[2]" 29;
IO_LOC "adc_db[3]" 30;
IO_LOC "adc_db[4]" 31;
IO_LOC "adc_db[5]" 77;
IO_LOC "adc_db[6]" 41;
IO_LOC "adc_db[7]" 42;
IO_PORT "adc_db[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "adc_db[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "adc_db[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "adc_db[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "adc_db[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "adc_db[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "adc_db[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_PORT "adc_db[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "adc_busy" 48;
IO_PORT "adc_busy" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// PROPUESTA reversible: FD en 73/J6-1. Aplicacion fisica requiere aprobacion.
IO_LOC "adc_fd" 73;
IO_PORT "adc_fd" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

IO_LOC "adc_convst" 15;
IO_LOC "adc_rd_n" 16;
IO_LOC "adc_cs_n" 17;
IO_LOC "adc_reset" 18;
IO_PORT "adc_convst" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "adc_rd_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "adc_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "adc_reset" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;

IO_LOC "led_fault_n" 19;
IO_PORT "led_fault_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "led_mode_n" 20;
IO_PORT "led_mode_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// Pares diferenciales copiados del esquema y ejemplo HDMI local de Sipeed.
// Cada IO_LOC del positivo fija tambien el negativo de TLVDS_OBUF.
IO_LOC "hdmi_clk_p" 33,34;
IO_PORT "hdmi_clk_p" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "hdmi_blue_p" 35,36;
IO_PORT "hdmi_blue_p" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "hdmi_green_p" 37,38;
IO_PORT "hdmi_green_p" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
IO_LOC "hdmi_red_p" 39,40;
IO_PORT "hdmi_red_p" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5 BANK_VCCIO=3.3;
